<Window x:Class="Nulltrap.App.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nulltrap"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        Opacity="0"
        MouseLeftButtonDown="OnClicked">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource PurpleBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="16,13"
            Width="360"
            Margin="20">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Lift" />
        </Border.RenderTransform>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="9"
                    VerticalAlignment="Top" ClipToBounds="True"
                    Background="{DynamicResource SurfaceHoverBrush}">
                <Image x:Name="NoticeIcon" Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <StackPanel Grid.Column="1" Margin="13,0,0,0">
                <TextBlock x:Name="NoticeTitle"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="NoticeBody"
                           Margin="0,3,0,0"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSoftBrush}" />
                <TextBlock x:Name="NoticeTail"
                           Margin="0,2,0,0"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSoftBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
