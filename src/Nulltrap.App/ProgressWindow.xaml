<local:ChromeWindow x:Class="Nulltrap.App.ProgressWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:local="clr-namespace:Nulltrap.App"
                    xmlns:loc="clr-namespace:Nulltrap.App.Localization"
                    mc:Ignorable="d"
                    Style="{StaticResource ChromeWindowStyle}"
                    Title="Nulltrap"
                    Height="270" Width="470"
                    ResizeMode="NoResize"
                    ShowCaption="False"
                    ShowInTaskbar="True"
                    WindowStartupLocation="CenterScreen">

    <Grid Margin="34,26,34,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image Grid.Row="0" Width="76" Height="76" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
            <Image.Source>
                <BitmapImage UriSource="Nulltrap.png" />
            </Image.Source>
        </Image>

        <TextBlock Grid.Row="1"
                   x:Name="StatusText"
                   Text="{loc:S progress.starting}"
                   Margin="0,18,0,0"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource TextBrush}"
                   FontSize="14" />

        <Border Grid.Row="2"
                Height="7"
                Margin="0,18,0,0"
                Background="{StaticResource SurfaceHoverBrush}"
                CornerRadius="4">
            <Border x:Name="ProgressFill"
                    HorizontalAlignment="Left"
                    Width="0"
                    Background="{StaticResource PurpleBrightBrush}"
                    CornerRadius="4" />
        </Border>

        <Button Grid.Row="3"
                x:Name="CancelButton"
                Content="{loc:S action.cancel}"
                Width="196"
                Height="34"
                Margin="0,18,0,0"
                HorizontalAlignment="Center"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                Click="OnCancel">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Face"
                                        Background="{StaticResource SurfaceHoverBrush}"
                                        CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Face" Property="Background" Value="{StaticResource PurpleBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</local:ChromeWindow>
