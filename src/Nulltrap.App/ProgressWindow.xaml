<Window x:Class="Nulltrap.App.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Nulltrap"
        Height="220" Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource VoidBrush}"
        UseLayoutRounding="True">

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Nulltrap"
                   Foreground="{StaticResource TextBrush}"
                   FontSize="24"
                   FontWeight="SemiBold" />

        <TextBlock Grid.Row="1"
                   x:Name="StatusText"
                   Margin="0,14,0,0"
                   Text="Starting"
                   Foreground="{StaticResource TextSoftBrush}"
                   FontSize="13"
                   TextTrimming="CharacterEllipsis" />

        <Border Grid.Row="2"
                Height="6"
                Margin="0,16,0,0"
                VerticalAlignment="Top"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="3">
            <Border x:Name="ProgressFill"
                    HorizontalAlignment="Left"
                    Width="0"
                    Background="{StaticResource PurpleBrightBrush}"
                    CornerRadius="3" />
        </Border>

        <Button Grid.Row="3"
                x:Name="CancelButton"
                Content="Cancel"
                Width="96"
                Height="30"
                HorizontalAlignment="Right"
                Foreground="{StaticResource TextBrush}"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource PurpleBrush}"
                BorderThickness="1"
                Cursor="Hand"
                Click="OnCancel" />
    </Grid>
</Window>
