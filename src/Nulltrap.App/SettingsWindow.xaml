<Window x:Class="Nulltrap.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Nulltrap settings"
        Height="470" Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource VoidBrush}"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="24,0,0,14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PurpleBrightBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,10" />
        </Style>
    </Window.Resources>

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource Section}" Text="INTEGRATION" />

                <CheckBox x:Name="RegisterStudioBox" Content="Handle Roblox Studio launches too" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Off by default. Studio has its own FastFlag rules and is usually best left to Roblox." />

                <CheckBox x:Name="DesktopShortcutBox" Content="Desktop shortcut" />
                <CheckBox x:Name="StartMenuShortcutBox" Content="Start menu shortcut" />
                <TextBlock Style="{StaticResource Hint}" Text="Applied the next time Nulltrap installs or repairs itself." />

                <TextBlock Style="{StaticResource Section}" Text="LAUNCHING" />

                <CheckBox x:Name="CloseAfterLaunchBox" Content="Close Nulltrap once Roblox starts" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Leaving it open costs about a hundred megabytes for no benefit yet. Session tracking in a later version will need it running." />

                <CheckBox x:Name="ConfirmMultipleInstancesBox" Content="Ask before starting a second Roblox client" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Running several clients at once is disputed under Roblox's terms. Nulltrap will not enable it silently." />

                <TextBlock Style="{StaticResource Section}" Text="STORAGE" />

                <CheckBox x:Name="KeepDownloadCacheBox" Content="Keep downloaded packages" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Packages are cached under their checksum, so an update only fetches what actually changed. Clearing frees space but makes the next update a full download." />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button x:Name="ClearCacheButton"
                            Content="Clear cache"
                            Height="28" MinWidth="110"
                            Cursor="Hand"
                            FontSize="12"
                            Foreground="{StaticResource TextSoftBrush}"
                            Background="Transparent"
                            BorderBrush="{StaticResource RuleBrush}"
                            BorderThickness="1"
                            Click="OnClearCache" />
                    <TextBlock x:Name="CacheSizeText"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSoftBrush}"
                               FontSize="11" />
                </StackPanel>

                <TextBlock Style="{StaticResource Section}" Text="CHANNEL" />

                <TextBox x:Name="ChannelBox"
                         Height="28"
                         Padding="8,4"
                         FontSize="12"
                         Foreground="{StaticResource TextBrush}"
                         Background="{StaticResource SurfaceBrush}"
                         BorderBrush="{StaticResource RuleBrush}"
                         BorderThickness="1"
                         CaretBrush="{StaticResource TextBrush}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,14"
                           Text="Leave as production unless you know why you are changing it. An unknown channel simply fails to launch." />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="94" Height="30" Margin="0,0,10,0"
                    Cursor="Hand" FontSize="12"
                    Foreground="{StaticResource TextSoftBrush}"
                    Background="Transparent"
                    BorderBrush="{StaticResource RuleBrush}"
                    BorderThickness="1"
                    Click="OnCancel" />
            <Button Content="Save" Width="94" Height="30"
                    Cursor="Hand" FontSize="12"
                    Foreground="{StaticResource TextBrush}"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource PurpleBrush}"
                    BorderThickness="1"
                    Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
