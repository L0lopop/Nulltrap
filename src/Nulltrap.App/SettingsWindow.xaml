<local:ChromeWindow x:Class="Nulltrap.App.SettingsWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:local="clr-namespace:Nulltrap.App"
                    xmlns:loc="clr-namespace:Nulltrap.App.Localization"
                    mc:Ignorable="d"
                    Style="{StaticResource ChromeWindowStyle}"
                    Title="Nulltrap — Settings"
                    Height="740" Width="1240"
                    MinHeight="560" MinWidth="900"
                    ResizeMode="CanResize"
                    ShowInTaskbar="False"
                    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource CaptionBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,16">
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" x:Name="NavNews" Tag="News" Content="{loc:S nav.news}" Checked="OnNavigate" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" x:Name="NavLauncher" Tag="Launcher" Content="{loc:S nav.settings}" Checked="OnNavigate" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" x:Name="NavAbout" Tag="About" Content="{loc:S nav.aboutNulltrap}" Checked="OnNavigate" />

                    <Border Height="1" Background="{StaticResource RuleBrush}" Margin="16,12,16,12" />

                    <StackPanel Margin="16,0,16,0">
                        <TextBlock x:Name="SidebarVersion"
                                   Foreground="{StaticResource TextSoftBrush}"
                                   FontSize="12" />
                        <TextBlock x:Name="SidebarLocation"
                                   Foreground="{StaticResource TextSoftBrush}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="Nav" Margin="0,14,0,0">
                    <TextBlock Style="{StaticResource NavSection}" Text="{loc:S nav.launcher}" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" x:Name="NavGeneral" Tag="General" Content="{loc:S nav.general}" IsChecked="True" Checked="OnNavigate" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" x:Name="NavMods" Tag="Mods" Content="{loc:S nav.mods}" Checked="OnNavigate" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" x:Name="NavPresence" Tag="Presence" Content="{loc:S nav.presence}" Checked="OnNavigate" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" x:Name="NavFlags" Tag="Flags" Content="{loc:S nav.flags}" Checked="OnNavigate" />

                    <TextBlock Style="{StaticResource NavSection}" Text="{loc:S nav.roblox}" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" x:Name="NavGraphics" Tag="Graphics" Content="{loc:S nav.graphics}" Checked="OnNavigate" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" x:Name="NavVersions" Tag="Versions" Content="{loc:S nav.versions}" Checked="OnNavigate" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" x:Name="NavActivity" Tag="Activity" Content="{loc:S nav.activity}" Checked="OnNavigate" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="38,26,38,0">
                <TextBlock x:Name="PageTitle"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="PageSubtitle"
                           Foreground="{StaticResource TextSoftBrush}"
                           FontSize="12"
                           Margin="0,3,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="38,20,26,0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <Grid>

                    <StackPanel x:Name="PageGeneral" Visibility="Collapsed">
                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S general.closeAfterLaunch}" />
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="{loc:S general.closeAfterLaunchHint}" />
                                </StackPanel>
                                <CheckBox x:Name="CloseAfterLaunchBox" Style="{StaticResource Switch}" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S general.autoUpdate}" />
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="{loc:S general.autoUpdateHint}" />
                                </StackPanel>
                                <CheckBox x:Name="AutomaticClientUpdatesBox" Style="{StaticResource Switch}" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S general.multiInstance}" />
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="{loc:S general.multiInstanceHint}" />
                                </StackPanel>
                                <CheckBox x:Name="ConfirmMultipleInstancesBox" Style="{StaticResource Switch}" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                    </StackPanel>

                    <StackPanel x:Name="PagePresence" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource GroupHeading}" Text="{loc:S presence.richPresence}" />
                            <TextBlock Style="{StaticResource RowHint}" Margin="2,-6,0,14"
                                       Text="{loc:S presence.richPresenceHint}" />

                            <Border Style="{StaticResource RowCard}">
                                <Grid>
                                    <StackPanel Margin="0,0,60,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S presence.enable}" />
                                        <TextBlock Style="{StaticResource RowHint}" Text="{loc:S presence.enableHint}" />
                                    </StackPanel>
                                    <CheckBox x:Name="PresenceEnabledBox" Style="{StaticResource Switch}"
                                              HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Click="OnPresenceChanged" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource RowCard}">
                                <Grid>
                                    <StackPanel Margin="0,0,60,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S presence.account}" />
                                        <TextBlock Style="{StaticResource RowHint}" Text="{loc:S presence.accountHint}" />
                                    </StackPanel>
                                    <CheckBox x:Name="PresenceAccountBox" Style="{StaticResource Switch}"
                                              HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Click="OnPresenceChanged" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource RowCard}">
                                <Grid>
                                    <StackPanel Margin="0,0,60,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S presence.join}" />
                                        <TextBlock Style="{StaticResource RowHint}" Text="{loc:S presence.joinHint}" />
                                    </StackPanel>
                                    <CheckBox x:Name="PresenceJoinBox" Style="{StaticResource Switch}"
                                              HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Click="OnPresenceChanged" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource RowCard}">
                                <StackPanel>
                                    <ToggleButton x:Name="CustomRpcHeader" Style="{StaticResource Row}"
                                                  Checked="OnToggleCustomRpc"
                                                  Unchecked="OnToggleCustomRpc">
                                        <Grid>
                                        <StackPanel Margin="0,0,40,0">
                                            <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S presence.custom}" />
                                            <TextBlock Style="{StaticResource RowHint}" Text="{loc:S presence.customHint}" />
                                        </StackPanel>
                                        <TextBlock x:Name="CustomRpcChevron" Text="&#xE70D;"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSoftBrush}"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform x:Name="CustomRpcTurn" Angle="0" />
                                            </TextBlock.RenderTransform>
                                            </TextBlock>
                                        </Grid>
                                    </ToggleButton>

                                    <StackPanel x:Name="CustomRpcBody" Visibility="Collapsed" Margin="0,16,0,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S presence.headline}" />
                                        <TextBlock Style="{StaticResource RowHint}" Text="{loc:S presence.headlineHint}" />
                                        <StackPanel Margin="0,10,0,0">
                                    <CheckBox x:Name="HeadGameNameBox" Style="{StaticResource Tick}"
                                              Content="{loc:S presence.headlineGame}" Click="OnPresenceChanged" />
                                    <CheckBox x:Name="HeadPlayingBox" Style="{StaticResource Tick}"
                                              Content="{loc:S presence.headlinePlaying}" Click="OnPresenceChanged" />
                                        </StackPanel>

                                        <TextBlock Style="{StaticResource RowTitle}" Margin="0,18,0,0" Text="{loc:S presence.subline}" />
                                        <TextBlock Style="{StaticResource RowHint}" Text="{loc:S presence.sublineHint}" />
                                        <StackPanel Margin="0,10,0,0">
                                    <CheckBox x:Name="SubCreatorBox" Style="{StaticResource Tick}"
                                              Content="{loc:S presence.sublineCreator}" Click="OnPresenceChanged" />
                                    <CheckBox x:Name="SubPlayersBox" Style="{StaticResource Tick}"
                                              Content="{loc:S presence.sublinePlayers}" Click="OnPresenceChanged" />
                                    <CheckBox x:Name="SubServerBox" Style="{StaticResource Tick}"
                                              Content="{loc:S presence.sublineServer}" Click="OnPresenceChanged" />
                                        </StackPanel>

                                        <TextBlock Style="{StaticResource RowTitle}" Margin="0,18,0,0" Text="{loc:S presence.alsoShow}" />
                                        <StackPanel Margin="0,10,0,0">
                                    <CheckBox x:Name="PresenceElapsedBox" Style="{StaticResource Tick}"
                                              Content="{loc:S presence.elapsed}" Click="OnPresenceChanged" />
                                    <CheckBox x:Name="PresenceIconBox" Style="{StaticResource Tick}"
                                              Content="{loc:S presence.icon}" Click="OnPresenceChanged" />
                                    <CheckBox x:Name="PresenceButtonBox" Style="{StaticResource Tick}"
                                              Content="{loc:S presence.button}" Click="OnPresenceChanged" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>


                            <Border x:Name="PresencePreview" Style="{StaticResource RowCard}" Padding="18,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="{loc:S presence.playing}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <Border HorizontalAlignment="Right" CornerRadius="4" Padding="8,3"
                                                Background="{StaticResource SurfaceHoverBrush}">
                                            <TextBlock Text="{loc:S presence.previewTag}" FontSize="11"
                                                       Foreground="{StaticResource TextSoftBrush}" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="64" Height="64" VerticalAlignment="Top">
                                            <Border x:Name="PreviewIcon" CornerRadius="8"
                                                    Background="{StaticResource AccentBrush}" />
                                            <TextBlock x:Name="PreviewIconGlyph" Text="R" FontSize="26" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextBrush}" />
                                            <Border x:Name="PreviewAccount" Width="24" Height="24" CornerRadius="12"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Margin="0,0,-6,-6"
                                                    Background="{StaticResource PurpleBrush}"
                                                    BorderBrush="{StaticResource SurfaceBrush}" BorderThickness="2">
                                                <TextBlock x:Name="PreviewAccountGlyph" FontSize="11" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextBrush}" />
                                            </Border>
                                        </Grid>

                                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Roblox" FontSize="13" FontWeight="Bold"
                                                       Foreground="{StaticResource TextBrush}" />
                                            <TextBlock x:Name="PreviewDetails" FontSize="13" Margin="0,3,0,0"
                                                       Foreground="{StaticResource TextBrush}" />
                                            <TextBlock x:Name="PreviewState" FontSize="12" Margin="0,2,0,0"
                                                       Foreground="{StaticResource TextSoftBrush}" />
                                            <TextBlock x:Name="PreviewElapsed" FontSize="12" Margin="0,2,0,0"
                                                       Foreground="#FF67D68A" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border x:Name="PreviewJoin" Margin="0,14,0,0" Padding="0,9"
                                            CornerRadius="4" Background="{StaticResource SurfaceHoverBrush}">
                                        <TextBlock x:Name="PreviewJoinText" FontSize="12" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextBrush}" />
                                    </Border>

                                    <Border x:Name="PreviewButton" Margin="0,8,0,0" Padding="0,9"
                                            CornerRadius="4" Background="{StaticResource SurfaceHoverBrush}">
                                        <TextBlock x:Name="PreviewButtonText" FontSize="12" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextBrush}" />
                                    </Border>
                                </StackPanel>
                            </Border>

                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S presence.status}" />
                                <TextBlock x:Name="PresenceStatusText" Style="{StaticResource RowHint}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <StackPanel x:Name="PageLauncher" Visibility="Collapsed">
                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S shortcuts.desktop}" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="{loc:S shortcuts.desktopHint}" />
                                </StackPanel>
                                <CheckBox x:Name="DesktopShortcutBox" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnShortcutsChanged" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S shortcuts.startMenu}" />
                                </StackPanel>
                                <CheckBox x:Name="StartMenuShortcutBox" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnShortcutsChanged" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,220,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S general.language}" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="{loc:S general.languageHint}" />
                                </StackPanel>
                                <StackPanel x:Name="LanguageButtons" Orientation="Horizontal"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,150,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S launcher.location}" />
                                    <TextBlock x:Name="LauncherLocationText" Style="{StaticResource RowHint}" />
                                </StackPanel>
                                <Button Style="{StaticResource Quiet}" Content="{loc:S action.openFolder}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnOpenFolder" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,150,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S launcher.repair}" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="{loc:S launcher.repairHint}" />
                                </StackPanel>
                                <Button x:Name="RepairButton" Style="{StaticResource Quiet}" Content="{loc:S action.repair}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnRepair" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S language.help}" />
                                <TextBlock Style="{StaticResource RowHint}" Text="{loc:S language.helpHint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource RowCard}" BorderBrush="{StaticResource DangerBrush}">
                            <Grid>
                                <StackPanel Margin="0,0,150,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S about.remove}" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="{loc:S about.removeHint}" />
                                </StackPanel>
                                <Button Style="{StaticResource Quiet}" Content="{loc:S action.uninstall}"
                                        Foreground="{StaticResource DangerBrush}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnUninstall" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PageGraphics" Visibility="Collapsed">
                        <Border Style="{StaticResource SubTabStrip}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SubTab}" GroupName="GraphicsTabs"
                                             x:Name="TabGraphicsQuality" Tag="GraphicsQuality"
                                             Content="{loc:S graphics.tabQuality}" IsChecked="True" Checked="OnSubTab" />
                                <RadioButton Style="{StaticResource SubTab}" GroupName="GraphicsTabs"
                                             x:Name="TabGraphicsSpeed" Tag="GraphicsSpeed"
                                             Content="{loc:S graphics.tabSpeed}" Checked="OnSubTab" />
                                <RadioButton Style="{StaticResource SubTab}" GroupName="GraphicsTabs"
                                             x:Name="TabGraphicsFlags" Tag="GraphicsFlags"
                                             Content="{loc:S graphics.tabFlags}" Checked="OnSubTab" />
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="GraphicsQuality">
                            <TextBlock Style="{StaticResource GroupHeading}" Text="{loc:S graphics.tabQuality}" />
                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S graphics.textureQuality}" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="{loc:S graphics.textureQualityHint}" />
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="TextureQualitySlider"
                                                Style="{StaticResource Slider}"
                                                Minimum="0" Maximum="9"
                                                ValueChanged="OnTextureQualityChanged" />
                                        <TextBlock x:Name="TextureQualityValue"
                                                   Grid.Column="1"
                                                   Margin="16,0,0,0"
                                                   MinWidth="96"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextBrush}" />
                                    </Grid>
                                </StackPanel>
                                <CheckBox x:Name="TextureQualityEnabledBox" Style="{StaticResource Switch}"
                                          HorizontalAlignment="Right" VerticalAlignment="Top"
                                          Click="OnTextureQualityToggled" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,190,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S graphics.msaa}" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="{loc:S graphics.msaaHint}" />
                                </StackPanel>
                                <ComboBox x:Name="MsaaBox" Style="{StaticResource Dropdown}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,190,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S graphics.grass}" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="{loc:S graphics.grassHint}" />
                                </StackPanel>
                                <ComboBox x:Name="GrassBox" Style="{StaticResource Dropdown}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S graphics.dpi}" />
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="{loc:S graphics.dpiHint}" />
                                </StackPanel>
                                <CheckBox x:Name="DisableDpiScaleBox" Style="{StaticResource Switch}" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                        </StackPanel>

                        <StackPanel x:Name="GraphicsSpeed">
                            <TextBlock Style="{StaticResource GroupHeading}" Text="{loc:S graphics.tabSpeed}" />

                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,190,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S graphics.api}" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="{loc:S graphics.apiHint}" />
                                </StackPanel>
                                <ComboBox x:Name="GraphicsApiBox" Style="{StaticResource Dropdown}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        </StackPanel>

                        <StackPanel x:Name="GraphicsFlags">
                            <TextBlock Style="{StaticResource GroupHeading}" Text="{loc:S graphics.tabFlags}" />
                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S graphics.summary}" />
                                <TextBlock x:Name="FlagSummaryText" Style="{StaticResource RowHint}" />
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </StackPanel>



                    <StackPanel x:Name="PageVersions" Visibility="Collapsed">
                        <Border Style="{StaticResource SubTabStrip}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SubTab}" GroupName="VersionsTabs"
                                             x:Name="TabVersionsPlayer" Tag="VersionsPlayer"
                                             Content="{loc:S versions.player}" IsChecked="True" Checked="OnSubTab" />
                                <RadioButton Style="{StaticResource SubTab}" GroupName="VersionsTabs"
                                             x:Name="TabVersionsStudio" Tag="VersionsStudio"
                                             Content="{loc:S versions.studio}" Checked="OnSubTab" />
                                <RadioButton Style="{StaticResource SubTab}" GroupName="VersionsTabs"
                                             x:Name="TabVersionsStorage" Tag="VersionsStorage"
                                             Content="{loc:S nav.storage}" Checked="OnSubTab" />
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="VersionsPlayer">
                            <TextBlock Style="{StaticResource GroupHeading}" Text="{loc:S versions.forClient}" />
                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,150,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S versions.installed}" />
                                    <TextBlock x:Name="InstalledVersionText" Style="{StaticResource RowHint}" />
                                    <TextBlock x:Name="InstalledGuidText" Style="{StaticResource RowHint}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button x:Name="RemoveVersionButton" Style="{StaticResource Quiet}"
                                        Content="{loc:S versions.remove}" MinWidth="128"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Click="OnRemoveVersion" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,150,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S versions.available}" />
                                    <TextBlock x:Name="AvailableVersionText" Style="{StaticResource RowHint}" />
                                    <TextBlock x:Name="AvailableChannelText" Style="{StaticResource RowHint}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button x:Name="CheckVersionButton" Style="{StaticResource Quiet}"
                                        Content="{loc:S versions.check}" MinWidth="128"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Click="OnCheckVersion" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Margin="0,0,290,0">
                                        <TextBlock x:Name="TransferTitle" Style="{StaticResource RowTitle}" />
                                        <TextBlock x:Name="TransferMessage" Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="CancelDownloadButton" Style="{StaticResource Quiet}"
                                                Content="{loc:S action.cancel}" MinWidth="128"
                                                Visibility="Collapsed" Click="OnCancelDownload" />
                                        <Button x:Name="DownloadButton" Style="{StaticResource Accent}"
                                                Content="{loc:S versions.download}" MinWidth="150" Margin="10,0,0,0"
                                                Click="OnDownload" />
                                    </StackPanel>
                                </Grid>

                                <Border x:Name="TransferTrack" Height="7" Margin="0,16,0,0"
                                        Background="{StaticResource SurfaceHoverBrush}" CornerRadius="4"
                                        SizeChanged="OnTransferTrackResized">
                                    <Border x:Name="TransferFill" HorizontalAlignment="Left" Width="0"
                                            Background="{StaticResource PurpleBrightBrush}" CornerRadius="4" />
                                </Border>

                                <Grid Margin="0,10,0,0">
                                    <TextBlock x:Name="TransferBytes" Style="{StaticResource RowHint}"
                                               HorizontalAlignment="Left" />
                                    <TextBlock x:Name="TransferRateText" Style="{StaticResource RowHint}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S deployment.channel}" />
                                <TextBlock Style="{StaticResource RowHint}" Text="{loc:S deployment.channelHint}" />
                                <TextBox x:Name="ChannelBox" Style="{StaticResource Field}"
                                         Width="260" HorizontalAlignment="Left" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                        </StackPanel>

                        <StackPanel x:Name="VersionsStorage">
                            <TextBlock Style="{StaticResource GroupHeading}" Text="{loc:S nav.storage}" />
                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S storage.keepCache}" />
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="{loc:S storage.keepCacheHint}" />
                                </StackPanel>
                                <CheckBox x:Name="KeepDownloadCacheBox" Style="{StaticResource Switch}" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,130,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S storage.cache}" />
                                    <TextBlock x:Name="CacheSizeText" Style="{StaticResource RowHint}" />
                                </StackPanel>
                                <Button x:Name="ClearCacheButton" Style="{StaticResource Quiet}" Content="{loc:S action.clear}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnClearCache" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,130,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S storage.versions}" />
                                    <TextBlock x:Name="VersionsSizeText" Style="{StaticResource RowHint}" />
                                </StackPanel>
                                <Button Style="{StaticResource Quiet}" Content="{loc:S action.openFolder}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnOpenFolder" />
                            </Grid>
                        </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="PageMods" Visibility="Collapsed">
                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S mods.enable}" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="{loc:S mods.enableHint}" />
                                </StackPanel>
                                <CheckBox x:Name="ModsEnabledBox" Style="{StaticResource Switch}"
                                          HorizontalAlignment="Right" VerticalAlignment="Top"
                                          Click="OnModsToggled" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Margin="0,0,290,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S mods.folder}" />
                                        <TextBlock x:Name="ModsFolderText" Style="{StaticResource RowHint}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource Quiet}" Content="{loc:S action.openFolder}"
                                                MinWidth="128" Click="OnOpenMods" />
                                        <Button x:Name="ApplyModsButton" Style="{StaticResource Accent}"
                                                Content="{loc:S mods.apply}" MinWidth="150" Margin="10,0,0,0"
                                                Click="OnApplyMods" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="ModsAppliedText" Style="{StaticResource RowHint}" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S mods.files}" />
                                <TextBlock Style="{StaticResource RowHint}" Text="{loc:S mods.filesHint}" />
                                <StackPanel x:Name="ModsPanel" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S mods.examples}" />
                                <TextBlock Style="{StaticResource RowHint}" Text="{loc:S mods.examplesHint}" />
                                <TextBlock Style="{StaticResource RowHint}" Margin="0,10,0,0" FontFamily="Consolas"
                                           Text="{loc:S mods.examplesList}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PageFlags" Visibility="Collapsed">
                        <Border Style="{StaticResource SubTabStrip}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SubTab}" GroupName="FlagsTabs"
                                             x:Name="TabFlagsFrames" Tag="FlagsFrames"
                                             Content="{loc:S flags.tabFrames}" IsChecked="True" Checked="OnSubTab" />
                                <RadioButton Style="{StaticResource SubTab}" GroupName="FlagsTabs"
                                             x:Name="TabFlagsReady" Tag="FlagsReady"
                                             Content="{loc:S flags.tabReady}" Checked="OnSubTab" />
                                <RadioButton Style="{StaticResource SubTab}" GroupName="FlagsTabs"
                                             x:Name="TabFlagsEditor" Tag="FlagsEditor"
                                             Content="{loc:S flags.tabEditor}" Checked="OnSubTab" />
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="FlagsFrames">
                            <TextBlock Style="{StaticResource GroupHeading}" Text="{loc:S flags.tabFrames}" />

                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S graphics.unlockFps}" />
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="{loc:S graphics.unlockFpsHint}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBox x:Name="FpsBox" Style="{StaticResource Field}" Width="110" />
                                        <TextBlock Text="{loc:S graphics.fpsUnit}"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSoftBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="FpsWarning" Style="{StaticResource RowHint}" Margin="0,10,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="UnlockFpsBox" Style="{StaticResource Switch}"
                                          HorizontalAlignment="Right" VerticalAlignment="Top"
                                          Click="OnUnlockFpsChanged" />
                            </Grid>
                        </Border>

                        </StackPanel>

                        <StackPanel x:Name="FlagsReady" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource GroupHeading}" Text="{loc:S flags.tabReady}" />

                            <Border Style="{StaticResource RowCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S flags.readyWhat}" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="{loc:S flags.readyWhatHint}" />
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="ReadyPanel" />
                        </StackPanel>

                        <StackPanel x:Name="FlagsEditor" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource GroupHeading}" Text="{loc:S flags.tabEditor}" />

                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S flags.yours}" />
                                <TextBlock Style="{StaticResource RowHint}" Text="{loc:S flags.yoursHint}" />
                                <TextBlock Style="{StaticResource RowHint}" Margin="0,8,0,0"
                                           Foreground="{StaticResource DangerBrush}"
                                           Text="{loc:S flags.yourRisk}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S flags.add}" />
                                <TextBlock Style="{StaticResource RowHint}" Text="{loc:S flags.addHint}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="FlagNameBox" Grid.Column="0" Style="{StaticResource Field}" />
                                    <TextBox x:Name="FlagValueBox" Grid.Column="2" Style="{StaticResource Field}" />
                                    <Button x:Name="AddFlagButton" Grid.Column="4" Style="{StaticResource Accent}"
                                            MinWidth="130" Content="{loc:S flags.addButton}" Click="OnAddFlag" />
                                </Grid>
                                <TextBlock x:Name="FlagProblemText" Style="{StaticResource RowHint}" Margin="0,10,0,0"
                                           Foreground="{StaticResource DangerBrush}" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Margin="0,0,150,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S flags.list}" />
                                        <TextBlock x:Name="FlagCountText" Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                    <Button x:Name="OpenFlagFileButton" Style="{StaticResource Quiet}"
                                            Content="{loc:S flags.openFile}" MinWidth="130"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Click="OnOpenFlagFile" />
                                </Grid>
                                <StackPanel x:Name="FlagsPanel" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="PageActivity" Visibility="Collapsed">
                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="PlayedTodayText" FontSize="24" FontWeight="SemiBold"
                                               Foreground="{StaticResource PurpleBrightBrush}" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="{loc:S activity.today}" Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="PlayedWeekText" FontSize="24" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="{loc:S activity.week}" Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="PlayedTotalText" FontSize="24" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="{loc:S activity.total}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S activity.favourites}" />
                                <TextBlock Style="{StaticResource RowHint}" Text="{loc:S activity.favouritesHint}" />
                                <StackPanel x:Name="FavouritesPanel" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Margin="0,0,150,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S activity.recent}" />
                                        <TextBlock Style="{StaticResource RowHint}" Text="{loc:S activity.recentHint}" />
                                    </StackPanel>
                                    <Button x:Name="ClearHistoryButton" Style="{StaticResource Quiet}"
                                            Content="{loc:S activity.clear}" MinWidth="128"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Click="OnClearHistory" />
                                </Grid>
                                <StackPanel x:Name="RecentPanel" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>


                    <StackPanel x:Name="PageNews" Visibility="Collapsed">
                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,150,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S news.update}" />
                                    <TextBlock x:Name="UpdateStateText" Style="{StaticResource RowHint}" />
                                </StackPanel>
                                <Button x:Name="CheckUpdateButton" Style="{StaticResource Quiet}"
                                        Content="{loc:S news.check}" MinWidth="130"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Click="OnCheckUpdate" />
                            </Grid>
                        </Border>

                        <Border x:Name="UpdateBanner" Style="{StaticResource RowCard}" Visibility="Collapsed"
                                Background="{StaticResource AccentBrush}">
                            <Grid>
                                <StackPanel Margin="0,0,150,0">
                                    <TextBlock x:Name="UpdateBannerTitle" Style="{StaticResource RowTitle}" />
                                    <TextBlock x:Name="UpdateBannerHint" Style="{StaticResource RowHint}"
                                               Foreground="{StaticResource TextBrush}" />
                                </StackPanel>
                                <Button x:Name="OpenReleaseButton" Style="{StaticResource Quiet}"
                                        Content="{loc:S news.open}" MinWidth="130"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Click="OnOpenRelease" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S news.planned}" />
                                <TextBlock Style="{StaticResource RowHint}" Text="{loc:S news.plannedHint}" />
                                <StackPanel x:Name="PlannedPanel" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S news.changes}" />
                                <TextBlock Style="{StaticResource RowHint}" Text="{loc:S news.changesHint}" />
                                <StackPanel x:Name="ChangelogPanel" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>


                    <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S about.flagsRisk}" />
                                <TextBlock Style="{StaticResource RowHint}" Text="{loc:S about.flagsRiskHint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Nulltrap.png" Width="52" Height="52"
                                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Top" />
                                <StackPanel Margin="16,0,0,0">
                                    <TextBlock Text="Nulltrap" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock x:Name="AboutVersionText" Style="{StaticResource RowHint}" Margin="0,2,0,0" />
                                    <TextBlock Style="{StaticResource RowHint}" Margin="0,8,0,0"
                                               Text="{loc:S about.unofficial}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S about.notDo}" />
                                <TextBlock Style="{StaticResource RowHint}"
                                           Text="{loc:S about.notDoHint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,130,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S about.source}" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="{loc:S about.sourceHint}" />
                                </StackPanel>
                                <Button Style="{StaticResource Quiet}" Content="{loc:S action.open}" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Click="OnOpenRepository" />
                            </Grid>
                        </Border>

                    </StackPanel>

                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{StaticResource CaptionBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="32,14,32,14">
                    <Border x:Name="SavedToast"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource PurpleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,6"
                            Opacity="0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                     Fill="{StaticResource PurpleBrightBrush}" />
                            <TextBlock x:Name="SavedToastText"
                                       Margin="9,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Quiet}" Content="{loc:S action.close}" Margin="0,0,8,0" Click="OnCancel" />
                        <Button Style="{StaticResource Accent}" Content="{loc:S action.save}" Click="OnSave" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</local:ChromeWindow>
