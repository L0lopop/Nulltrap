                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="AddFlagButton" Style="{StaticResource Quiet}" MinWidth="128"
                                            Content="{loc:S flags.add}" Click="OnAddFlag" />
                                    <Button x:Name="RemoveChosenButton" Style="{StaticResource Quiet}" MinWidth="188"
                                            Margin="8,0,0,0" IsEnabled="False"
                                            Content="{loc:S flags.removeChosen}" Click="OnRemoveChosenFlags" />
                                    <Button x:Name="RemoveAllButton" Style="{StaticResource Quiet}" MinWidth="142"
                                            Margin="8,0,0,0"
                                            Content="{loc:S flags.removeAll}" Click="OnRemoveAllFlags" />
                                    <ToggleButton x:Name="ShowPresetBox" Style="{StaticResource Pill}"
                                                  Margin="8,0,0,0"
                                                  Content="{loc:S flags.showPreset}"
                                                  Checked="OnFlagFilterChanged" Unchecked="OnFlagFilterChanged" />
                                </StackPanel>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <TextBox x:Name="FlagSearchBox" Style="{StaticResource Field}"
                                                 Padding="32,0,10,0"
                                                 TextChanged="OnFlagSearch" />
                                        <TextBlock Text="&#xE721;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Foreground="{StaticResource TextSoftBrush}" />
                                        <TextBlock x:Name="FlagSearchHint"
                                                   Text="{loc:S flags.search}"
                                                   Margin="34,0,0,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextSoftBrush}" />
                                    </Grid>

                                    <TextBlock x:Name="FlagFactsText" Grid.Column="1"
                                               Margin="18,0,2,0" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{StaticResource TextSoftBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource RowCard}" Padding="0">
                            <StackPanel>
                                <Border Background="{StaticResource SurfaceHoverBrush}"
                                        CornerRadius="10,10,0,0" Padding="14,9,14,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="132" />
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="200" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" Text="{loc:S flags.colTags}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSoftBrush}" />
                                        <TextBlock Grid.Column="2" Text="{loc:S flags.colPreset}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSoftBrush}" />
                                        <TextBlock Grid.Column="3" Text="{loc:S flags.colName}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSoftBrush}" />
                                        <TextBlock Grid.Column="4" Text="{loc:S flags.colValue}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSoftBrush}" />
                                    </Grid>
                                </Border>

                                <StackPanel x:Name="FlagsPanel" Margin="0,4,0,4" />

                                <StackPanel x:Name="FlagsEmpty" Margin="0,54,0,58" Visibility="Collapsed">
                                    <TextBlock Text="&#xE7C1;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="34"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource RuleBrush}" />
                                    <TextBlock x:Name="FlagsEmptyText"
                                               Margin="0,14,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{StaticResource TextSoftBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Quiet}" MinWidth="150"
                                        Content="{loc:S flags.export}" Click="OnExportFlags" />
                                <Button Style="{StaticResource Quiet}" MinWidth="168" Margin="8,0,0,0"
                                        Content="{loc:S flags.copy}" Click="OnCopyFlags" />
                                <Button Style="{StaticResource Quiet}" MinWidth="150" Margin="8,0,0,0"
                                        Content="{loc:S flags.openFile}" Click="OnOpenFlagFile" />
                                <TextBlock x:Name="FlagNoticeText" Margin="16,0,0,0" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{StaticResource PurpleBrightBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PageActivity" Visibility="Collapsed">
                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="PlayedTodayText" FontSize="24" FontWeight="SemiBold"
                                               Foreground="{StaticResource PurpleBrightBrush}" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="{loc:S activity.today}" Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="PlayedWeekText" FontSize="24" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="{loc:S activity.week}" Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="PlayedTotalText" FontSize="24" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="{loc:S activity.total}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S activity.favourites}" />
                                <TextBlock Style="{StaticResource RowHint}" Text="{loc:S activity.favouritesHint}" />
                                <StackPanel x:Name="FavouritesPanel" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Margin="0,0,150,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S activity.recent}" />
                                        <TextBlock Style="{StaticResource RowHint}" Text="{loc:S activity.recentHint}" />
                                    </StackPanel>
                                    <Button x:Name="ClearHistoryButton" Style="{StaticResource Quiet}"
                                            Content="{loc:S activity.clear}" MinWidth="128"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Click="OnClearHistory" />
                                </Grid>
                                <StackPanel x:Name="RecentPanel" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>


                    <StackPanel x:Name="PageNews" Visibility="Collapsed">
                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,150,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S news.update}" />
                                    <TextBlock x:Name="UpdateStateText" Style="{StaticResource RowHint}" />
                                </StackPanel>
                                <Button x:Name="CheckUpdateButton" Style="{StaticResource Quiet}"
                                        Content="{loc:S news.check}" MinWidth="130"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Click="OnCheckUpdate" />
                            </Grid>
                        </Border>

                        <Border x:Name="UpdateBanner" Style="{StaticResource RowCard}" Visibility="Collapsed"
                                Background="{StaticResource AccentBrush}">
                            <Grid>
                                <StackPanel Margin="0,0,150,0">
                                    <TextBlock x:Name="UpdateBannerTitle" Style="{StaticResource RowTitle}" />
                                    <TextBlock x:Name="UpdateBannerHint" Style="{StaticResource RowHint}"
                                               Foreground="{StaticResource TextBrush}" />
                                </StackPanel>
                                <Button x:Name="OpenReleaseButton" Style="{StaticResource Quiet}"
                                        Content="{loc:S news.open}" MinWidth="130"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Click="OnOpenRelease" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S news.planned}" />
                                <TextBlock Style="{StaticResource RowHint}" Text="{loc:S news.plannedHint}" />
                                <StackPanel x:Name="PlannedPanel" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S news.changes}" />
                                <TextBlock Style="{StaticResource RowHint}" Text="{loc:S news.changesHint}" />
                                <StackPanel x:Name="ChangelogPanel" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>


                    <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S about.flagsRisk}" />
                                <TextBlock Style="{StaticResource RowHint}" Text="{loc:S about.flagsRiskHint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Top">
                                    <Image.Source>
                                        <BitmapImage UriSource="Nulltrap.png" />
                                    </Image.Source>
                                </Image>
                                <StackPanel Margin="16,0,0,0">
                                    <TextBlock Text="Nulltrap" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock x:Name="AboutVersionText" Style="{StaticResource RowHint}" Margin="0,2,0,0" />
                                    <TextBlock Style="{StaticResource RowHint}" Margin="0,8,0,0"
                                               Text="{loc:S about.unofficial}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S about.notDo}" />
                                <TextBlock Style="{StaticResource RowHint}"
                                           Text="{loc:S about.notDoHint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,130,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S about.source}" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="{loc:S about.sourceHint}" />
                                </StackPanel>
                                <Button Style="{StaticResource Quiet}" Content="{loc:S action.open}" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Click="OnOpenRepository" />
                            </Grid>
                        </Border>

                    </StackPanel>

                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{StaticResource CaptionBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="32,14,32,14">
                    <Border x:Name="SavedToast"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource PurpleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,6"
                            Opacity="0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                     Fill="{StaticResource PurpleBrightBrush}" />
                            <TextBlock x:Name="SavedToastText"
                                       Margin="9,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Quiet}" Content="{loc:S action.close}" Margin="0,0,8,0" Click="OnCancel" />
                        <Button Style="{StaticResource Accent}" Content="{loc:S action.save}" Click="OnSave" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</local:ChromeWindow>
