<local:ChromeWindow x:Class="Nulltrap.App.SettingsWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:local="clr-namespace:Nulltrap.App"
                    xmlns:loc="clr-namespace:Nulltrap.App.Localization"
                    mc:Ignorable="d"
                    Style="{StaticResource ChromeWindowStyle}"
                    Title="Nulltrap — Settings"
                    Height="740" Width="1240"
                    MinHeight="560" MinWidth="900"
                    ResizeMode="CanResize"
                    ShowMaximize="True"
                    ShowInTaskbar="False"
                    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource CaptionBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,16">
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" x:Name="NavNews" Tag="News" Content="{loc:S nav.news}" Checked="OnNavigate" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" x:Name="NavLauncher" Tag="Launcher" Content="{loc:S nav.settings}" Checked="OnNavigate" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" x:Name="NavAbout" Tag="About" Content="{loc:S nav.aboutNulltrap}" Checked="OnNavigate" />

                    <Border Height="1" Background="{StaticResource RuleBrush}" Margin="16,12,16,12" />

                    <StackPanel Margin="16,0,16,0">
                        <TextBlock x:Name="SidebarVersion"
                                   Foreground="{StaticResource TextSoftBrush}"
                                   FontSize="12" />
                        <TextBlock x:Name="SidebarLocation"
                                   Foreground="{StaticResource TextSoftBrush}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="Nav" Margin="0,14,0,0">
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" x:Name="NavHome" Tag="Home" Content="{loc:S nav.home}" IsChecked="True" Checked="OnNavigate" />

                    <TextBlock Style="{StaticResource NavSection}" Text="{loc:S nav.launcher}" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" x:Name="NavGeneral" Tag="General" Content="{loc:S nav.general}" Checked="OnNavigate" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" x:Name="NavMods" Tag="Mods" Content="{loc:S nav.mods}" Checked="OnNavigate" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" x:Name="NavPresence" Tag="Presence" Content="{loc:S nav.presence}" Checked="OnNavigate" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" x:Name="NavFlags" Tag="Flags" Content="{loc:S nav.flags}" Checked="OnNavigate" />

                    <TextBlock Style="{StaticResource NavSection}" Text="{loc:S nav.roblox}" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" x:Name="NavGraphics" Tag="Graphics" Content="{loc:S nav.graphics}" Checked="OnNavigate" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" x:Name="NavVersions" Tag="Versions" Content="{loc:S nav.versions}" Checked="OnNavigate" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" x:Name="NavActivity" Tag="Activity" Content="{loc:S nav.activity}" Checked="OnNavigate" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="38,26,38,0">
                <TextBlock x:Name="PageTitle"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="PageSubtitle"
                           Foreground="{StaticResource TextSoftBrush}"
                           FontSize="12"
                           Margin="0,3,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="38,20,26,0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <Grid>

                    <StackPanel x:Name="PageHome">
                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="66" Height="66" CornerRadius="33"
                                        ClipToBounds="True" VerticalAlignment="Top"
                                        Background="{StaticResource SurfaceHoverBrush}">
                                    <Image x:Name="ProfileAvatar" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="18,2,0,0">
                                    <TextBlock x:Name="ProfileName" FontSize="19" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock x:Name="ProfileHandle" FontSize="12" Margin="0,2,0,0"
                                               Foreground="{StaticResource TextSoftBrush}" />

                                    <StackPanel x:Name="ProfileStats" Orientation="Horizontal" Margin="0,14,0,0">
                                        <StackPanel Margin="0,0,34,0">
                                            <TextBlock x:Name="ProfileTotal" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PurpleBrightBrush}" />
                                            <TextBlock Text="{loc:S activity.total}" FontSize="12" Margin="0,2,0,0"
                                                       Foreground="{StaticResource TextSoftBrush}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,34,0">
                                            <TextBlock x:Name="ProfileGames" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{loc:S home.gamesPlayed}" FontSize="12" Margin="0,2,0,0"
                                                       Foreground="{StaticResource TextSoftBrush}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock x:Name="ProfileToday" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{loc:S activity.today}" FontSize="12" Margin="0,2,0,0"
                                                       Foreground="{StaticResource TextSoftBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource GroupHeading}" Text="{loc:S home.recommended}" />
                        <TextBlock Style="{StaticResource RowHint}" Margin="2,-6,0,12"
                                   Text="{loc:S home.recommendedHint}" />

                        <Border Style="{StaticResource RowCard}" Padding="18,18,18,20">
                            <Grid>
                                <TextBlock x:Name="RecommendedEmpty" FontSize="12"
                                           Foreground="{StaticResource TextSoftBrush}"
                                           Text="{loc:S home.recommendedEmpty}" />
                                <UniformGrid x:Name="RecommendedPanel" Columns="5" Margin="0,0,-12,0" />
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource GroupHeading}" Text="{loc:S home.before}" />
                        <TextBlock Style="{StaticResource RowHint}" Margin="2,-6,0,12"
                                   Text="{loc:S home.beforeHint}" />

                        <Border Style="{StaticResource RowCard}" Padding="18,18,18,20">
                            <Grid>
                                <TextBlock x:Name="RecentEmpty" FontSize="12"
                                           Foreground="{StaticResource TextSoftBrush}"
                                           Text="{loc:S activity.nothingYet}" />
                                <UniformGrid x:Name="RecentGamesPanel" Columns="5" Margin="0,0,-12,0" />
                            </Grid>
                        </Border>
                    </StackPanel>


                    <StackPanel x:Name="PageGeneral" Visibility="Collapsed">
                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S general.closeAfterLaunch}" />
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="{loc:S general.closeAfterLaunchHint}" />
                                </StackPanel>
                                <CheckBox x:Name="CloseAfterLaunchBox" Style="{StaticResource Switch}" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S graphics.unlockFps}" />
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="{loc:S graphics.unlockFpsHint}" />
                                </StackPanel>
                                <CheckBox x:Name="UnlockFpsBox" Style="{StaticResource Switch}"
                                          HorizontalAlignment="Right" VerticalAlignment="Top"
                                          Click="OnUnlockFpsChanged" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S general.autoUpdate}" />
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="{loc:S general.autoUpdateHint}" />
                                </StackPanel>
                                <CheckBox x:Name="AutomaticClientUpdatesBox" Style="{StaticResource Switch}" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S general.multiInstance}" />
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="{loc:S general.multiInstanceHint}" />
                                </StackPanel>
                                <CheckBox x:Name="ConfirmMultipleInstancesBox" Style="{StaticResource Switch}" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                    </StackPanel>

                    <StackPanel x:Name="PagePresence" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource GroupHeading}" Text="{loc:S presence.richPresence}" />
                            <TextBlock Style="{StaticResource RowHint}" Margin="2,-6,0,14"
                                       Text="{loc:S presence.richPresenceHint}" />

                            <Border Style="{StaticResource RowCard}">
                                <Grid>
                                    <StackPanel Margin="0,0,60,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S presence.enable}" />
                                        <TextBlock Style="{StaticResource RowHint}" Text="{loc:S presence.enableHint}" />
                                    </StackPanel>
                                    <CheckBox x:Name="PresenceEnabledBox" Style="{StaticResource Switch}"
                                              HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Click="OnPresenceChanged" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource RowCard}">
                                <Grid>
                                    <StackPanel Margin="0,0,60,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S presence.account}" />
                                        <TextBlock Style="{StaticResource RowHint}" Text="{loc:S presence.accountHint}" />
                                    </StackPanel>
                                    <CheckBox x:Name="PresenceAccountBox" Style="{StaticResource Switch}"
                                              HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Click="OnPresenceChanged" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource RowCard}">
                                <Grid>
                                    <StackPanel Margin="0,0,60,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S presence.join}" />
                                        <TextBlock Style="{StaticResource RowHint}" Text="{loc:S presence.joinHint}" />
                                    </StackPanel>
                                    <CheckBox x:Name="PresenceJoinBox" Style="{StaticResource Switch}"
                                              HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Click="OnPresenceChanged" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource RowCard}">
                                <StackPanel>
                                    <ToggleButton x:Name="CustomRpcHeader" Style="{StaticResource Row}"
                                                  Checked="OnToggleCustomRpc"
                                                  Unchecked="OnToggleCustomRpc">
                                        <Grid>
                                        <StackPanel Margin="0,0,40,0">
                                            <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S presence.custom}" />
                                            <TextBlock Style="{StaticResource RowHint}" Text="{loc:S presence.customHint}" />
                                        </StackPanel>
                                        <TextBlock x:Name="CustomRpcChevron" Text="&#xE70D;"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSoftBrush}"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform x:Name="CustomRpcTurn" Angle="0" />
                                            </TextBlock.RenderTransform>
                                            </TextBlock>
                                        </Grid>
                                    </ToggleButton>

                                    <StackPanel x:Name="CustomRpcBody" Visibility="Collapsed" Margin="0,16,0,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S presence.headline}" />
                                        <TextBlock Style="{StaticResource RowHint}" Text="{loc:S presence.headlineHint}" />
                                        <StackPanel Margin="0,10,0,0">
                                    <CheckBox x:Name="HeadGameNameBox" Style="{StaticResource Tick}"
                                              Content="{loc:S presence.headlineGame}" Click="OnPresenceChanged" />
                                    <CheckBox x:Name="HeadPlayingBox" Style="{StaticResource Tick}"
                                              Content="{loc:S presence.headlinePlaying}" Click="OnPresenceChanged" />
                                        </StackPanel>

                                        <TextBlock Style="{StaticResource RowTitle}" Margin="0,18,0,0" Text="{loc:S presence.subline}" />
                                        <TextBlock Style="{StaticResource RowHint}" Text="{loc:S presence.sublineHint}" />
                                        <StackPanel Margin="0,10,0,0">
                                    <CheckBox x:Name="SubCreatorBox" Style="{StaticResource Tick}"
                                              Content="{loc:S presence.sublineCreator}" Click="OnPresenceChanged" />
                                    <CheckBox x:Name="SubPlayersBox" Style="{StaticResource Tick}"
                                              Content="{loc:S presence.sublinePlayers}" Click="OnPresenceChanged" />
                                    <CheckBox x:Name="SubServerBox" Style="{StaticResource Tick}"
                                              Content="{loc:S presence.sublineServer}" Click="OnPresenceChanged" />
                                        </StackPanel>

                                        <TextBlock Style="{StaticResource RowTitle}" Margin="0,18,0,0" Text="{loc:S presence.alsoShow}" />
                                        <StackPanel Margin="0,10,0,0">
                                    <CheckBox x:Name="PresenceElapsedBox" Style="{StaticResource Tick}"
                                              Content="{loc:S presence.elapsed}" Click="OnPresenceChanged" />
                                    <CheckBox x:Name="PresenceIconBox" Style="{StaticResource Tick}"
                                              Content="{loc:S presence.icon}" Click="OnPresenceChanged" />
                                    <CheckBox x:Name="PresenceButtonBox" Style="{StaticResource Tick}"
                                              Content="{loc:S presence.button}" Click="OnPresenceChanged" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>


                            <Border x:Name="PresencePreview" Style="{StaticResource RowCard}" Padding="18,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="{loc:S presence.playing}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <Border HorizontalAlignment="Right" CornerRadius="4" Padding="8,3"
                                                Background="{StaticResource SurfaceHoverBrush}">
                                            <TextBlock Text="{loc:S presence.previewTag}" FontSize="11"
                                                       Foreground="{StaticResource TextSoftBrush}" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="64" Height="64" VerticalAlignment="Top">
                                            <Border x:Name="PreviewIcon" CornerRadius="8"
                                                    Background="{StaticResource AccentBrush}" />
                                            <TextBlock x:Name="PreviewIconGlyph" Text="R" FontSize="26" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextBrush}" />
                                            <Border x:Name="PreviewAccount" Width="24" Height="24" CornerRadius="12"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Margin="0,0,-6,-6"
                                                    Background="{StaticResource PurpleBrush}"
                                                    BorderBrush="{StaticResource SurfaceBrush}" BorderThickness="2">
                                                <TextBlock x:Name="PreviewAccountGlyph" FontSize="11" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextBrush}" />
                                            </Border>
                                        </Grid>

                                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Roblox" FontSize="13" FontWeight="Bold"
                                                       Foreground="{StaticResource TextBrush}" />
                                            <TextBlock x:Name="PreviewDetails" FontSize="13" Margin="0,3,0,0"
                                                       Foreground="{StaticResource TextBrush}" />
                                            <TextBlock x:Name="PreviewState" FontSize="12" Margin="0,2,0,0"
                                                       Foreground="{StaticResource TextSoftBrush}" />
                                            <TextBlock x:Name="PreviewElapsed" FontSize="12" Margin="0,2,0,0"
                                                       Foreground="#FF67D68A" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border x:Name="PreviewJoin" Margin="0,14,0,0" Padding="0,9"
                                            CornerRadius="4" Background="{StaticResource SurfaceHoverBrush}">
                                        <TextBlock x:Name="PreviewJoinText" FontSize="12" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextBrush}" />
                                    </Border>

                                    <Border x:Name="PreviewButton" Margin="0,8,0,0" Padding="0,9"
                                            CornerRadius="4" Background="{StaticResource SurfaceHoverBrush}">
                                        <TextBlock x:Name="PreviewButtonText" FontSize="12" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextBrush}" />
                                    </Border>
                                </StackPanel>
                            </Border>

                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S presence.status}" />
                                <TextBlock x:Name="PresenceStatusText" Style="{StaticResource RowHint}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <StackPanel x:Name="PageLauncher" Visibility="Collapsed">
                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S shortcuts.desktop}" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="{loc:S shortcuts.desktopHint}" />
                                </StackPanel>
                                <CheckBox x:Name="DesktopShortcutBox" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnShortcutsChanged" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S shortcuts.startMenu}" />
                                </StackPanel>
                                <CheckBox x:Name="StartMenuShortcutBox" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnShortcutsChanged" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,220,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S general.language}" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="{loc:S general.languageHint}" />
                                </StackPanel>
                                <StackPanel x:Name="LanguageButtons" Orientation="Horizontal"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,150,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S launcher.location}" />
                                    <TextBlock x:Name="LauncherLocationText" Style="{StaticResource RowHint}" />
                                </StackPanel>
                                <Button Style="{StaticResource Quiet}" Content="{loc:S action.openFolder}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnOpenFolder" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <StackPanel Margin="0,0,150,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S launcher.repair}" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="{loc:S launcher.repairHint}" />
                                </StackPanel>
                                <Button x:Name="RepairButton" Style="{StaticResource Quiet}" Content="{loc:S action.repair}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnRepair" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S language.help}" />
                                <TextBlock Style="{StaticResource RowHint}" Text="{loc:S language.helpHint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource RowCard}" BorderBrush="{StaticResource DangerBrush}">
                            <Grid>
                                <StackPanel Margin="0,0,150,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S about.remove}" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="{loc:S about.removeHint}" />
                                </StackPanel>
                                <Button Style="{StaticResource Quiet}" Content="{loc:S action.uninstall}"
                                        Foreground="{StaticResource DangerBrush}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnUninstall" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PageGraphics" Visibility="Collapsed">
                        <Border Style="{StaticResource SubTabStrip}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SubTab}" GroupName="GraphicsTabs"
                                             x:Name="TabGraphicsQuality" Tag="GraphicsQuality"
                                             Content="{loc:S graphics.tabQuality}" IsChecked="True" Checked="OnSubTab" />
                                <RadioButton Style="{StaticResource SubTab}" GroupName="GraphicsTabs"
                                             x:Name="TabGraphicsFrames" Tag="GraphicsFrames"
                                             Content="{loc:S flags.tabFrames}" Checked="OnSubTab" />
                                <RadioButton Style="{StaticResource SubTab}" GroupName="GraphicsTabs"
                                             x:Name="TabGraphicsSound" Tag="GraphicsSound"
                                             Content="{loc:S graphics.tabSound}" Checked="OnSubTab" />
                                <RadioButton Style="{StaticResource SubTab}" GroupName="GraphicsTabs"
                                             x:Name="TabGraphicsInterface" Tag="GraphicsInterface"
                                             Content="{loc:S graphics.tabInterface}" Checked="OnSubTab" />
                                <RadioButton Style="{StaticResource SubTab}" GroupName="GraphicsTabs"
                                             x:Name="TabGraphicsControl" Tag="GraphicsControl"
                                             Content="{loc:S graphics.tabControl}" Checked="OnSubTab" />
                                <RadioButton Style="{StaticResource SubTab}" GroupName="GraphicsTabs"
                                             x:Name="TabGraphicsReady" Tag="GraphicsReady"
                                             Content="{loc:S flags.tabReady}" Checked="OnSubTab" />
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="GraphicsQuality">
                            <TextBlock Style="{StaticResource GroupHeading}" Text="{loc:S graphics.ownHeading}" />
                            <TextBlock x:Name="RobloxOwner1" Style="{StaticResource RowHint}" Margin="2,-6,0,12"
                                       Text="{loc:S graphics.ownHint}" />

                            <Border Style="{StaticResource RowCard}">
                                <Grid>
                                    <StackPanel Margin="0,0,230,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S graphics.qualityMode}" />
                                        <TextBlock Style="{StaticResource RowHint}" Text="{loc:S graphics.qualityModeHint}" />
                                    </StackPanel>
                                    <ComboBox x:Name="QualityModeBox" Style="{StaticResource Dropdown}" Width="220"
                                      SelectionChanged="OnQualityModeChanged"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource RowCard}">
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S graphics.level}" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="{loc:S graphics.levelHint}" />
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <local:StepBar x:Name="QualityLevelSlider" Steps="10" Lowest="1"
                                           Changed="OnStepBarChanged" />
                                        <TextBlock x:Name="QualityLevelSliderValue" Grid.Column="1"
                                                   Margin="16,0,0,0" MinWidth="104" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="{StaticResource TextBrush}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource RowCard}">
                                <Grid>
                                    <StackPanel Margin="0,0,230,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S graphics.optimization}" />
                                        <TextBlock Style="{StaticResource RowHint}" Text="{loc:S graphics.optimizationHint}" />
                                    </StackPanel>
                                    <ComboBox x:Name="OptimizationBox" Style="{StaticResource Dropdown}" Width="220"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource RowCard}">
                                <Grid>
                                    <StackPanel Margin="0,0,60,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S graphics.maxQuality}" />
                                        <TextBlock Style="{StaticResource RowHint}" Text="{loc:S graphics.maxQualityHint}" />
                                    </StackPanel>
                                    <CheckBox x:Name="MaxQualityBox" Style="{StaticResource Switch}" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource RowCard}">
                                <Grid>
                                    <StackPanel Margin="0,0,60,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S graphics.vignette}" />
                                        <TextBlock Style="{StaticResource RowHint}" Text="{loc:S graphics.vignetteHint}" />
                                    </StackPanel>
                                    <CheckBox x:Name="VignetteBox" Style="{StaticResource Switch}" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <TextBlock Style="{StaticResource GroupHeading}" Text="{loc:S graphics.flagHeading}" />
                            <TextBlock Style="{StaticResource RowHint}" Margin="2,-6,0,12"
                                       Text="{loc:S graphics.flagHint}" />

                            <Border Style="{StaticResource RowCard}">
                                <Grid>
                                    <StackPanel Margin="0,0,230,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S graphics.textureQuality}" />
                                        <TextBlock Style="{StaticResource RowHint}" Text="{loc:S graphics.textureQualityHint}" />
                                    </StackPanel>
                                    <ComboBox x:Name="TextureQualityBox" Style="{StaticResource Dropdown}" Width="220"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
