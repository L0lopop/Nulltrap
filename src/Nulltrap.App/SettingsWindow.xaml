<local:ChromeWindow x:Class="Nulltrap.App.SettingsWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:local="clr-namespace:Nulltrap.App"
                    mc:Ignorable="d"
                    Style="{StaticResource ChromeWindowStyle}"
                    Title="Nulltrap — Settings"
                    Height="560" Width="640"
                    ResizeMode="NoResize"
                    ShowMinimize="False"
                    WindowStartupLocation="CenterOwner">

    <local:ChromeWindow.Resources>

        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track"
                                Width="40" Height="22"
                                CornerRadius="11"
                                Background="{StaticResource RuleBrush}">
                            <Ellipse x:Name="Knob"
                                     Width="16" Height="16"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0"
                                     Fill="{StaticResource TextSoftBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource PurpleBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                                <Setter TargetName="Knob" Property="Fill" Value="{StaticResource GlowBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PurpleBrightBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,14,0,9" />
        </Style>

    </local:ChromeWindow.Resources>

    <Grid Margin="24,16,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Settings"
                   Foreground="{StaticResource TextBrush}"
                   FontSize="21"
                   FontWeight="SemiBold" />

        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>

                <TextBlock Style="{StaticResource SectionLabel}" Text="INTEGRATION" />

                <Border Style="{StaticResource RowCard}">
                    <Grid>
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Handle Roblox Studio" />
                            <TextBlock Style="{StaticResource RowHint}"
                                       Text="Off by default. Studio is not affected by the FastFlag allowlist and is usually best left to Roblox." />
                        </StackPanel>
                        <CheckBox x:Name="RegisterStudioBox" Style="{StaticResource Switch}" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource RowCard}">
                    <Grid>
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Desktop shortcut" />
                            <TextBlock Style="{StaticResource RowHint}" Text="Applied next time Nulltrap installs or repairs itself." />
                        </StackPanel>
                        <CheckBox x:Name="DesktopShortcutBox" Style="{StaticResource Switch}" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource RowCard}">
                    <Grid>
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Start menu shortcut" />
                        </StackPanel>
                        <CheckBox x:Name="StartMenuShortcutBox" Style="{StaticResource Switch}" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource SectionLabel}" Text="LAUNCHING" />

                <Border Style="{StaticResource RowCard}">
                    <Grid>
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Close once Roblox starts" />
                            <TextBlock Style="{StaticResource RowHint}"
                                       Text="Staying open costs about a hundred megabytes for no benefit yet. Session tracking will need it running later." />
                        </StackPanel>
                        <CheckBox x:Name="CloseAfterLaunchBox" Style="{StaticResource Switch}" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource RowCard}">
                    <Grid>
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Ask before a second Roblox client" />
                            <TextBlock Style="{StaticResource RowHint}"
                                       Text="Running several clients at once is disputed under Roblox's terms. Nulltrap will not enable it silently." />
                        </StackPanel>
                        <CheckBox x:Name="ConfirmMultipleInstancesBox" Style="{StaticResource Switch}" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource SectionLabel}" Text="STORAGE" />

                <Border Style="{StaticResource RowCard}">
                    <Grid>
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Keep downloaded packages" />
                            <TextBlock Style="{StaticResource RowHint}"
                                       Text="Packages are cached under their checksum, so an update only fetches what actually changed." />
                        </StackPanel>
                        <CheckBox x:Name="KeepDownloadCacheBox" Style="{StaticResource Switch}" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource RowCard}">
                    <Grid>
                        <StackPanel Margin="0,0,130,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Download cache" />
                            <TextBlock x:Name="CacheSizeText" Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <Button x:Name="ClearCacheButton"
                                Style="{StaticResource Quiet}"
                                Content="Clear"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="OnClearCache" />
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource SectionLabel}" Text="DEPLOYMENT" />

                <Border Style="{StaticResource RowCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowTitle}" Text="Channel" />
                        <TextBlock Style="{StaticResource RowHint}"
                                   Text="Leave as production unless you know why you are changing it. An unknown channel simply fails to launch." />
                        <TextBox x:Name="ChannelBox"
                                 Height="30"
                                 Margin="0,10,0,0"
                                 Padding="9,5"
                                 FontSize="12"
                                 Foreground="{StaticResource TextBrush}"
                                 Background="{StaticResource VoidBrush}"
                                 BorderBrush="{StaticResource RuleBrush}"
                                 BorderThickness="1"
                                 CaretBrush="{StaticResource TextBrush}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource Quiet}" Content="Cancel" Margin="0,0,8,0" Click="OnCancel" />
            <Button Style="{StaticResource Accent}" Content="Save" Click="OnSave" />
        </StackPanel>
    </Grid>
</local:ChromeWindow>
