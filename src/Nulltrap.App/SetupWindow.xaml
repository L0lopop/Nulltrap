<local:ChromeWindow x:Class="Nulltrap.App.SetupWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:local="clr-namespace:Nulltrap.App"
                    xmlns:loc="clr-namespace:Nulltrap.App.Localization"
                    mc:Ignorable="d"
                    Style="{StaticResource ChromeWindowStyle}"
                    Title="Nulltrap — Setup"
                    Height="520" Width="640"
                    MinHeight="460" MinWidth="600"
                    ResizeMode="CanResize"
                    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="34,26,34,0">
            <StackPanel Orientation="Horizontal">
                <Image Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Top">
                    <Image.Source>
                        <BitmapImage UriSource="Nulltrap.png" />
                    </Image.Source>
                </Image>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StepTitle"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="StepSubtitle"
                               Foreground="{DynamicResource TextSoftBrush}"
                               FontSize="12"
                               Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="StepCounter"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Foreground="{DynamicResource TextSoftBrush}"
                       FontSize="12" />
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="34,22,26,0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <Grid>

                <StackPanel x:Name="StepWelcome">
                    <Border Style="{StaticResource RowCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S setup.whatIs}" />
                            <TextBlock Style="{StaticResource RowHint}"
                                       Text="{loc:S setup.whatIsHint}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RowCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S about.notDo}" />
                            <TextBlock Style="{StaticResource RowHint}"
                                       Text="{loc:S setup.notDoHint}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RowCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S setup.responsible}" />
                            <TextBlock Style="{StaticResource RowHint}"
                                       Text="{loc:S setup.responsibleHint}" />
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="AgreeBox"
                              Margin="4,6,0,0"
                              Foreground="{DynamicResource TextBrush}"
                              FontSize="12"
                              Cursor="Hand"
                              Content="{loc:S setup.agree}"
                              Click="OnAgreeChanged" />
                </StackPanel>

                <StackPanel x:Name="StepOptions" Visibility="Collapsed">
                    <Border Style="{StaticResource RowCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S setup.handlers}" />
                            <TextBlock Style="{StaticResource RowHint}" Text="{loc:S setup.handlersHint}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RowCard}">
                        <Grid>
                            <StackPanel Margin="0,0,60,0">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S shortcuts.desktop}" />
                            </StackPanel>
                            <CheckBox x:Name="DesktopShortcutBox" Style="{StaticResource Switch}" IsChecked="True" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RowCard}">
                        <Grid>
                            <StackPanel Margin="0,0,60,0">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S shortcuts.startMenu}" />
                            </StackPanel>
                            <CheckBox x:Name="StartMenuShortcutBox" Style="{StaticResource Switch}" IsChecked="True" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RowCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S setup.location}" />
                            <TextBlock x:Name="LocationText" Style="{StaticResource RowHint}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="StepDownload" Visibility="Collapsed">
                    <Border Style="{StaticResource RowCard}">
                        <Grid>
                            <StackPanel Margin="0,0,60,0">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S setup.player}" />
                                <TextBlock Style="{StaticResource RowHint}"
                                           Text="{loc:S setup.playerHint}" />
                            </StackPanel>
                            <CheckBox x:Name="DownloadPlayerBox" Style="{StaticResource Switch}" IsChecked="True" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RowCard}">
                        <Grid>
                            <StackPanel Margin="0,0,60,0">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S setup.studio}" />
                                <TextBlock Style="{StaticResource RowHint}"
                                           Text="{loc:S setup.studioSizeHint}" />
                            </StackPanel>
                            <CheckBox x:Name="DownloadStudioBox" Style="{StaticResource Switch}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RowCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S setup.nothing}" />
                            <TextBlock Style="{StaticResource RowHint}"
                                       Text="{loc:S setup.nothingHint}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="StepProgress" Visibility="Collapsed">
                    <Border Style="{StaticResource RowCard}">
                        <StackPanel>
                            <TextBlock x:Name="ProgressStatus" Style="{StaticResource RowTitle}" Text="{loc:S setup.working}" />
                            <Border Height="5" Margin="0,14,0,0" Background="{DynamicResource VoidBrush}" CornerRadius="3">
                                <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0"
                                        Background="{DynamicResource PurpleBrightBrush}" CornerRadius="3" />
                            </Border>
                            <TextBlock x:Name="ProgressDetail" Style="{StaticResource RowHint}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="StepDone" Visibility="Collapsed">
                    <Border Style="{StaticResource RowCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S setup.ready}" />
                            <TextBlock x:Name="DoneSummary" Style="{StaticResource RowHint}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RowCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="{loc:S setup.next}" />
                            <TextBlock Style="{StaticResource RowHint}"
                                       Text="{loc:S setup.nextHint}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource CaptionBrush}" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="26,12,26,12">
                <Button x:Name="BackButton" Style="{StaticResource Quiet}" Content="{loc:S action.back}"
                        HorizontalAlignment="Left" Click="OnBack" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SecondaryButton" Style="{StaticResource Quiet}" Content="{loc:S home.settings}"
                            Margin="0,0,8,0" Visibility="Collapsed" Click="OnSecondary" />
                    <Button x:Name="NextButton" Style="{StaticResource Accent}" Content="{loc:S action.continue}" Click="OnNext" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</local:ChromeWindow>
