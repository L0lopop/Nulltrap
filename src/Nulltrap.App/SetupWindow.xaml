<local:ChromeWindow x:Class="Nulltrap.App.SetupWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:local="clr-namespace:Nulltrap.App"
                    mc:Ignorable="d"
                    Style="{StaticResource ChromeWindowStyle}"
                    Title="Nulltrap — Setup"
                    Height="520" Width="640"
                    ResizeMode="NoResize"
                    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="34,26,34,0">
            <StackPanel Orientation="Horizontal">
                <Image Source="Nulltrap.png" Width="44" Height="44"
                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Top" />
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StepTitle"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="StepSubtitle"
                               Foreground="{StaticResource TextSoftBrush}"
                               FontSize="12"
                               Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="StepCounter"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Foreground="{StaticResource TextSoftBrush}"
                       FontSize="11" />
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="34,22,26,0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <Grid>

                <StackPanel x:Name="StepWelcome">
                    <Border Style="{StaticResource RowCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="What Nulltrap is" />
                            <TextBlock Style="{StaticResource RowHint}"
                                       Text="It replaces the Roblox bootstrapper. It downloads the official Roblox client from Roblox's own servers, unpacks it into your user profile and starts it. Nothing is installed for other users and no administrator rights are needed." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RowCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="What Nulltrap does not do" />
                            <TextBlock Style="{StaticResource RowHint}"
                                       Text="It does not inject into, modify or read the memory of the Roblox client. It does not bypass anti-cheat. It does not try to work around the FastFlag allowlist - Roblox has said that editing flags in memory carries consequences, and Nulltrap will not do it." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RowCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="Who is responsible" />
                            <TextBlock Style="{StaticResource RowHint}"
                                       Text="Nulltrap is an unofficial project, not affiliated with or endorsed by Roblox Corporation. It is provided as is, under the MIT licence, with no warranty. You are responsible for how you use it." />
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="AgreeBox"
                              Margin="4,6,0,0"
                              Foreground="{StaticResource TextBrush}"
                              FontSize="12"
                              Cursor="Hand"
                              Content="I have read the above and want to continue"
                              Click="OnAgreeChanged" />
                </StackPanel>

                <StackPanel x:Name="StepOptions" Visibility="Collapsed">
                    <Border Style="{StaticResource RowCard}">
                        <Grid>
                            <StackPanel Margin="0,0,60,0">
                                <TextBlock Style="{StaticResource RowTitle}" Text="Handle Roblox launches" />
                                <TextBlock x:Name="ReplaceHint" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox x:Name="RegisterPlayerBox" Style="{StaticResource Switch}" IsChecked="True" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RowCard}">
                        <Grid>
                            <StackPanel Margin="0,0,60,0">
                                <TextBlock Style="{StaticResource RowTitle}" Text="Handle Roblox Studio launches" />
                                <TextBlock Style="{StaticResource RowHint}"
                                           Text="Off by default. Studio is not affected by the FastFlag allowlist." />
                            </StackPanel>
                            <CheckBox x:Name="RegisterStudioBox" Style="{StaticResource Switch}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RowCard}">
                        <Grid>
                            <StackPanel Margin="0,0,60,0">
                                <TextBlock Style="{StaticResource RowTitle}" Text="Desktop shortcut" />
                            </StackPanel>
                            <CheckBox x:Name="DesktopShortcutBox" Style="{StaticResource Switch}" IsChecked="True" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RowCard}">
                        <Grid>
                            <StackPanel Margin="0,0,60,0">
                                <TextBlock Style="{StaticResource RowTitle}" Text="Start menu shortcut" />
                            </StackPanel>
                            <CheckBox x:Name="StartMenuShortcutBox" Style="{StaticResource Switch}" IsChecked="True" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RowCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="Install location" />
                            <TextBlock x:Name="LocationText" Style="{StaticResource RowHint}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="StepDownload" Visibility="Collapsed">
                    <Border Style="{StaticResource RowCard}">
                        <Grid>
                            <StackPanel Margin="0,0,60,0">
                                <TextBlock Style="{StaticResource RowTitle}" Text="Roblox Player" />
                                <TextBlock Style="{StaticResource RowHint}"
                                           Text="About 200 MB to download, roughly 320 MB once unpacked. Needed to play." />
                            </StackPanel>
                            <CheckBox x:Name="DownloadPlayerBox" Style="{StaticResource Switch}" IsChecked="True" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RowCard}">
                        <Grid>
                            <StackPanel Margin="0,0,60,0">
                                <TextBlock Style="{StaticResource RowTitle}" Text="Roblox Studio" />
                                <TextBlock Style="{StaticResource RowHint}"
                                           Text="Considerably larger and only needed if you build experiences. It can be downloaded later from the launcher." />
                            </StackPanel>
                            <CheckBox x:Name="DownloadStudioBox" Style="{StaticResource Switch}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RowCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="Nothing selected?" />
                            <TextBlock Style="{StaticResource RowHint}"
                                       Text="That is fine. Nulltrap installs itself now and downloads the client the first time you press Launch." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="StepProgress" Visibility="Collapsed">
                    <Border Style="{StaticResource RowCard}">
                        <StackPanel>
                            <TextBlock x:Name="ProgressStatus" Style="{StaticResource RowTitle}" Text="Working" />
                            <Border Height="5" Margin="0,14,0,0" Background="{StaticResource VoidBrush}" CornerRadius="3">
                                <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0"
                                        Background="{StaticResource PurpleBrightBrush}" CornerRadius="3" />
                            </Border>
                            <TextBlock x:Name="ProgressDetail" Style="{StaticResource RowHint}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="StepDone" Visibility="Collapsed">
                    <Border Style="{StaticResource RowCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="Nulltrap is ready" />
                            <TextBlock x:Name="DoneSummary" Style="{StaticResource RowHint}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RowCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="What happens now" />
                            <TextBlock Style="{StaticResource RowHint}"
                                       Text="The Play button on the Roblox website opens Nulltrap, which checks for a client update and starts Roblox. You can change any of this later in Settings." />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource CaptionBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="26,12,26,12">
                <Button x:Name="BackButton" Style="{StaticResource Quiet}" Content="Back"
                        HorizontalAlignment="Left" Click="OnBack" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SecondaryButton" Style="{StaticResource Quiet}" Content="Settings"
                            Margin="0,0,8,0" Visibility="Collapsed" Click="OnSecondary" />
                    <Button x:Name="NextButton" Style="{StaticResource Accent}" Content="Continue" Click="OnNext" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</local:ChromeWindow>
