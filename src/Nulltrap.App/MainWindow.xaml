<local:ChromeWindow x:Class="Nulltrap.App.MainWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:local="clr-namespace:Nulltrap.App"
                    mc:Ignorable="d"
                    Style="{StaticResource ChromeWindowStyle}"
                    Title="Nulltrap"
                    Height="330" Width="640"
                    MinHeight="300" MinWidth="560"
                    ResizeMode="CanResize"
                    WindowStartupLocation="CenterScreen">

    <Grid Margin="26,22,26,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <Image Source="Nulltrap.png"
                   Width="72" Height="72"
                   HorizontalAlignment="Left"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <TextBlock Text="Nulltrap"
                       Margin="0,14,0,0"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="26"
                       FontWeight="SemiBold" />

            <TextBlock x:Name="VersionText"
                       Foreground="{StaticResource TextSoftBrush}"
                       FontSize="12" />

            <TextBlock x:Name="ClientText"
                       Margin="0,10,0,0"
                       Foreground="{StaticResource TextSoftBrush}"
                       FontSize="11"
                       TextWrapping="Wrap" />

            <Button Style="{StaticResource Link}"
                    Margin="0,14,0,0"
                    Content="Project on GitHub"
                    Click="OnOpenRepository" />

            <Button x:Name="InstallLink"
                    Style="{StaticResource Link}"
                    Click="OnInstall" />
        </StackPanel>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.ColumnSpan="3"
                    x:Name="PlayButton"
                    Style="{StaticResource Card}"
                    Click="OnLaunchPlayer">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Launch Roblox" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="PlayHint"
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource TextSoftBrush}" />
                    </StackPanel>
                    <TextBlock Text="&#xE76C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSoftBrush}" />
                </Grid>
            </Button>

            <Button Grid.Row="2" Grid.Column="0"
                    x:Name="StudioButton"
                    Style="{StaticResource Card}"
                    Click="OnLaunchStudio">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Studio" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="StudioHint"
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource TextSoftBrush}" />
                    </StackPanel>
                    <TextBlock Text="&#xE76C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSoftBrush}" />
                </Grid>
            </Button>

            <Button Grid.Row="2" Grid.Column="2"
                    Style="{StaticResource Card}"
                    Click="OnSettings">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Settings" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="launcher options"
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource TextSoftBrush}" />
                    </StackPanel>
                    <TextBlock Text="&#xE76C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSoftBrush}" />
                </Grid>
            </Button>

            <Button Grid.Row="4" Grid.ColumnSpan="3"
                    Style="{StaticResource Card}"
                    Click="OnOpenInstallFolder">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HandlerTitle" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="HandlerHint"
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextSoftBrush}" />
                    </StackPanel>
                    <TextBlock Text="&#xE76C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSoftBrush}" />
                </Grid>
            </Button>
        </Grid>
    </Grid>
</local:ChromeWindow>
