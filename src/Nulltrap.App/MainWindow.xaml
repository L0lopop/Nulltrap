<Window x:Class="Nulltrap.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Nulltrap"
        Height="440" Width="560"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource VoidBrush}"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PurpleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid Margin="34,30,34,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Nulltrap"
                   Foreground="{StaticResource TextBrush}"
                   FontSize="30"
                   FontWeight="SemiBold" />

        <TextBlock Grid.Row="1"
                   Margin="0,2,0,0"
                   Text="Alternative Roblox bootstrapper for Windows"
                   Foreground="{StaticResource TextSoftBrush}"
                   FontSize="12" />

        <Border Grid.Row="2"
                Margin="0,22,0,0"
                Padding="18,14"
                VerticalAlignment="Top"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource PurpleBrush}"
                BorderThickness="2,0,0,0">
            <StackPanel x:Name="StatusPanel" />
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,14">
            <Button x:Name="InstallButton" Style="{StaticResource Action}" Click="OnInstall" />
            <Button x:Name="LaunchButton" Style="{StaticResource Action}" Content="Launch Roblox" Click="OnLaunch" />
        </StackPanel>

        <TextBlock Grid.Row="4"
                   x:Name="FooterText"
                   Foreground="{StaticResource TextSoftBrush}"
                   FontSize="11"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
