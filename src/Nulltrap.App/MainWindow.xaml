<local:ChromeWindow x:Class="Nulltrap.App.MainWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:local="clr-namespace:Nulltrap.App"
                    xmlns:loc="clr-namespace:Nulltrap.App.Localization"
                    mc:Ignorable="d"
                    Style="{StaticResource ChromeWindowStyle}"
                    Title="Nulltrap"
                    Height="330" Width="640"
                    MinHeight="300" MinWidth="560"
                    ResizeMode="CanResize"
                    WindowStartupLocation="CenterScreen">

    <Grid Margin="26,22,26,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <Image Width="72" Height="72" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Source>
                    <BitmapImage UriSource="Nulltrap.png" />
                </Image.Source>
            </Image>

            <TextBlock Text="Nulltrap"
                       Margin="0,14,0,0"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="26"
                       FontWeight="SemiBold" />

            <TextBlock x:Name="VersionText"
                       Foreground="{StaticResource TextSoftBrush}"
                       FontSize="12" />

            <TextBlock x:Name="ClientText"
                       Margin="0,10,0,0"
                       Foreground="{StaticResource TextSoftBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />

            <Button Style="{StaticResource Link}"
                    Margin="0,14,0,0"
                    Content="{loc:S home.github}"
                    Click="OnOpenRepository" />

            <Button x:Name="InstallLink"
                    Style="{StaticResource Link}"
                    Visibility="Collapsed"
                    Content="{loc:S home.install}"
                    Click="OnInstall" />
        </StackPanel>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="1.35*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.Column="0"
                    x:Name="StudioButton"
                    Style="{StaticResource Card}"
                    Click="OnLaunchStudio">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:S home.studio}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="StudioHint"
                                   FontSize="12"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource TextSoftBrush}" />
                    </StackPanel>
                    <TextBlock Text="&#xE76C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSoftBrush}" />
                </Grid>
            </Button>

            <Button Grid.Row="0" Grid.Column="2"
                    x:Name="SettingsButton"
                    Style="{StaticResource Card}"
                    Click="OnSettings">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:S home.settings}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:S home.settingsHint}"
                                   FontSize="12"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource TextSoftBrush}" />
                    </StackPanel>
                    <TextBlock Text="&#xE76C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSoftBrush}" />
                </Grid>
            </Button>

            <Button Grid.Row="2" Grid.ColumnSpan="3"
                    x:Name="AboutButton"
                    Style="{StaticResource Card}"
                    Click="OnAbout">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:S home.about}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:S home.aboutHint}"
                                   FontSize="12"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource TextSoftBrush}" />
                    </StackPanel>
                    <TextBlock Text="&#xE76C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSoftBrush}" />
                </Grid>
            </Button>

            <Button Grid.Row="4" Grid.ColumnSpan="3"
                    x:Name="PlayButton"
                    Style="{StaticResource PlayCard}"
                    Click="OnLaunchPlayer">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE768;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   VerticalAlignment="Center"
                                   Foreground="#FFFFFFFF" />
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:S home.launch}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="PlayHint"
                                       FontSize="12"
                                       Margin="0,2,0,0"
                                       Opacity="0.85" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="&#xE76C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Opacity="0.85" />
                </Grid>
            </Button>
        </Grid>
    </Grid>
</local:ChromeWindow>
