<Window x:Class="Nulltrap.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Nulltrap"
        Height="470" Width="560"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource VoidBrush}"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Height" Value="70" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource PurpleBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource PurpleBrightBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Secondary" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid Margin="30,26,30,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image Source="Nulltrap.ico" Width="34" Height="34" VerticalAlignment="Center" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Nulltrap"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Text="Alternative Roblox bootstrapper"
                           Foreground="{StaticResource TextSoftBrush}"
                           FontSize="11" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="PlayButton" Style="{StaticResource Primary}" Click="OnLaunchPlayer">
                <StackPanel>
                    <TextBlock Text="Launch Roblox" HorizontalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock x:Name="PlayHint" Text="" HorizontalAlignment="Center" Margin="0,4,0,0"
                               FontSize="11" Foreground="{StaticResource TextSoftBrush}" />
                </StackPanel>
            </Button>

            <Button Grid.Column="2" x:Name="StudioButton" Style="{StaticResource Primary}" Click="OnLaunchStudio">
                <StackPanel>
                    <TextBlock Text="Launch Studio" HorizontalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock x:Name="StudioHint" Text="" HorizontalAlignment="Center" Margin="0,4,0,0"
                               FontSize="11" Foreground="{StaticResource TextSoftBrush}" />
                </StackPanel>
            </Button>

            <Button Grid.Column="4" x:Name="SettingsButton" Style="{StaticResource Primary}" Click="OnSettings">
                <StackPanel>
                    <TextBlock Text="Settings" HorizontalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Text="launcher options" HorizontalAlignment="Center" Margin="0,4,0,0"
                               FontSize="11" Foreground="{StaticResource TextSoftBrush}" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,20,0,0"
                Padding="18,14"
                VerticalAlignment="Top"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource PurpleBrush}"
                BorderThickness="2,0,0,0">
            <StackPanel x:Name="StatusPanel" />
        </Border>

        <Grid Grid.Row="4">
            <TextBlock x:Name="FooterText"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSoftBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,0,130,0" />
            <Button x:Name="InstallButton"
                    Style="{StaticResource Secondary}"
                    HorizontalAlignment="Right"
                    Click="OnInstall" />
        </Grid>
    </Grid>
</Window>
