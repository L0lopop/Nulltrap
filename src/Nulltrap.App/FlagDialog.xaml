<local:ChromeWindow x:Class="Nulltrap.App.FlagDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:local="clr-namespace:Nulltrap.App"
                    xmlns:loc="clr-namespace:Nulltrap.App.Localization"
                    mc:Ignorable="d"
                    Style="{StaticResource ChromeWindowStyle}"
                    Title="{loc:S flags.dialogTitle}"
                    Height="430" Width="560"
                    ShowMinimize="False"
                    ResizeMode="NoResize"
                    ShowInTaskbar="False"
                    WindowStartupLocation="CenterOwner">

    <Grid Margin="26,20,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
            <TextBlock Text="&#xE8A5;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSoftBrush}" />
            <CheckBox x:Name="Base64Box"
                      Style="{StaticResource Tick}"
                      Margin="10,0,0,0"
                      VerticalAlignment="Center"
                      Content="{loc:S flags.base64}"
                      Checked="OnBase64Changed" Unchecked="OnBase64Changed" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource SubTabStrip}" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource SubTab}" GroupName="FlagDialogTabs"
                             x:Name="TabOne" Content="{loc:S flags.tabOne}"
                             IsChecked="True" Checked="OnTab" />
                <RadioButton Style="{StaticResource SubTab}" GroupName="FlagDialogTabs"
                             x:Name="TabJson" Content="{loc:S flags.tabJson}" Checked="OnTab" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <StackPanel x:Name="PanelOne">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:S flags.name}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource TextSoftBrush}" />
                    <TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource Field}"
                             FontFamily="Consolas" TextChanged="OnTyped" />
                </Grid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:S flags.value}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource TextSoftBrush}" />
                    <TextBox x:Name="ValueBox" Grid.Column="1" Style="{StaticResource Field}"
                             FontFamily="Consolas" TextChanged="OnTyped" />
                    <Button x:Name="SuggestButton" Grid.Column="3" Style="{StaticResource Quiet}"
                            MinWidth="34" Content="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                            Click="OnSuggest">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="Suggestions">
                                <MenuItem Header="True" Click="OnSuggested" />
                                <MenuItem Header="False" Click="OnSuggested" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>

                <TextBlock Style="{StaticResource RowHint}" Margin="0,16,0,0"
                           Text="{loc:S flags.addHint}" />
                <TextBlock Style="{StaticResource RowHint}" Margin="0,8,0,0"
                           Foreground="{DynamicResource DangerBrush}"
                           Text="{loc:S flags.yourRisk}" />
            </StackPanel>

            <StackPanel x:Name="PanelJson" Visibility="Collapsed">
                <TextBox x:Name="JsonBox"
                         Style="{StaticResource Field}"
                         Height="130"
                         FontFamily="Consolas"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         Padding="10,8,10,8"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="OnTyped" />

                <Button Style="{StaticResource Quiet}"
                        Margin="0,12,0,0"
                        Height="34"
                        HorizontalAlignment="Stretch"
                        Content="{loc:S flags.importFile}"
                        Click="OnImportFile" />

                <TextBlock Style="{StaticResource RowHint}" Margin="0,14,0,0"
                           Text="{loc:S flags.jsonHint}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="ProblemText"
                       VerticalAlignment="Center"
                       Margin="0,0,220,0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DangerBrush}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ConfirmButton" Style="{StaticResource Accent}" MinWidth="96"
                        IsEnabled="False" Content="{loc:S action.ok}" Click="OnConfirm" />
                <Button Style="{StaticResource Quiet}" MinWidth="110" Margin="8,0,0,0"
                        Content="{loc:S action.cancel}" Click="OnCancel" />
            </StackPanel>
        </Grid>
    </Grid>
</local:ChromeWindow>
